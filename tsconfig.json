{
  "compilerOptions": {
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "checkJs": false,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "paths": { "~/*": ["src/*"] },
    "resolveJsonModule": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
  },
  "ts-node": {
    "transpileOnly": true
  },
  "include": ["src", "test", "support", "examples", "bin", "*.ts"],
  "exclude": ["node_modules", "build", "public", "dist", "tmp", "temp", "vendor"]
}
